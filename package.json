{
  "name": "srabontelecom-customer-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:mock": "node mock-server/server.mjs",
    "dev:mock:lan": "MOCK_HOST=0.0.0.0 node mock-server/server.mjs --allow-remote",
    "dev:mock:app": "EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:4000 EXPO_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key EXPO_PUBLIC_SUPABASE_READS_ENABLED=true expo start --web",
    "dev:mock:app:proxy": "EXPO_PUBLIC_SUPABASE_URL=same-origin EXPO_PUBLIC_API_BASE_URL=same-origin/customer EXPO_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key EXPO_PUBLIC_SUPABASE_READS_ENABLED=true expo start --web --port 8083",
    "dev:mock:proxy": "node scripts/dev-web-proxy.mjs",
    "dev:mock:android": "EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:4000 EXPO_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key EXPO_PUBLIC_SUPABASE_READS_ENABLED=true expo start",
    "prebuild": "expo prebuild --clean",
    "build:android": "bash scripts/eas-build.sh",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run typecheck:admin",
    "verify:rls": "node scripts/verify-rls.mjs",
    "check:signup": "node scripts/check-signup.mjs",
    "dev:mock:keep": "node mock-server/server.mjs --supervise",
    "dev:mock:proxy:keep": "node scripts/dev-web-proxy.mjs --supervise",
    "typecheck:admin": "npm --prefix admin run typecheck"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-background-task": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./modules"
      ]
    }
  }
}
