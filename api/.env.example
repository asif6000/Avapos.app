# The API's configuration. Copy to `.env` for local use, or set these in the
# Vercel project's Environment Variables — a real deployment reads them from
# there, never from a file in the repository.
#
# `SUPABASE_SERVICE_ROLE_KEY` is a server secret. It bypasses RLS, which is why it
# can read the tables the customer's own token is now restricted to. It must never
# reach a phone: not in EXPO_PUBLIC_*, not in the app bundle, not in AsyncStorage.
# `__tests__/noSecretsInClient.test.ts` in the app enforces that half.

# The Supabase project ref. Also used to build the JWKS URL and to check `iss`,
# so it must match the project the customers sign in to.
SUPABASE_PROJECT_REF=vslediphrlrlhrormmxh

# PostgREST endpoint. Trailing slash is fine.
SUPABASE_URL=https://vslediphrlrlhrormmxh.supabase.co

# Server-only. Either the new `sb_secret_...` form or the legacy `service_role`
# JWT. Neither is a publishable key — `sb_publishable_...` and `eyJ...` anon are
# for the app, and neither will work here.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if the signing keys are not at the project's public URL. Leave blank
# for Supabase Cloud; a self-hosted instance needs it.
# SUPABASE_JWKS_URL=

# Comma-separated origins allowed to read responses from a browser. The native
# build ignores CORS entirely, so this matters only for the admin panel and any
# web build. No entry means CORS is off, and the service says so on startup rather
# than pretending it is configured.
# ALLOWED_ORIGINS=https://app.srabontelecom.com

# Local listen port. Ignored on Vercel.
# PORT=4001
