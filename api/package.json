{
  "name": "srabon-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only customer API. Replaces the Laravel /customer service for everything except the payment gateway.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node --experimental-strip-types --test __tests__/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
