# Public (browser-safe) Supabase configuration for the customer app.
#
# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# The key below MUST be the publishable / `anon` key — the new `sb_publishable_...`
# form or the legacy `eyJ...` anon JWT. Both are designed to be shipped inside a
# public bundle; RLS is what keeps them harmless.
#
# NEVER put any of these in an EXPO_PUBLIC_* variable, in app.config.ts, in
# .env.local, in SecureStore, or in the bundle. There is no client-side use for
# any of them, and any that leaks is a full database takeover:
#
#   service_role  / service_role key   -> bypasses RLS entirely, full read/write
#   secret        / sb_secret_...      -> same
#   database password, gateway secret, admin credentials
#
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Set to "false" only after `npm run verify:rls` passes. The app refuses to read
# any Supabase table while this is not "true", so a missing RLS policy fails
# closed instead of leaking customer rows.
EXPO_PUBLIC_SUPABASE_READS_ENABLED=false

# REST API used for anything privileged: payment order creation, payment status
# verification, device state, agreement acceptance, device enrollment.
EXPO_PUBLIC_API_BASE_URL=https://srabontelecom.paymently.io/customer
